#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

run_helper() {
  installed=$1
  local_name=$2
  shift 2
  if command -v "$installed" >/dev/null 2>&1; then
    exec "$installed" "$@"
  fi
  exec "$SCRIPT_DIR/$local_name" "$@"
}

cmd=${1:-help}
[ "$#" -eq 0 ] || shift

case "$cmd" in
  doctor)
    run_helper eduamigae-self-test student-self-test.sh "$@"
    ;;
  import-evo)
    src=${1:?usage: eduamigae import-evo evo394.lha [DEST]}
    dst=${2:-${EVO_HOME:-/toolchains/evo/3.9.4}}
    run_helper eduamigae-import-evo import-evo.sh "$src" "$dst"
    ;;
  build)
    src=${1:?usage: eduamigae build SOURCE [OUTPUT]}
    base=$(basename "$src")
    stem=${base%.*}
    out=${2:-build/$stem}
    run_helper eduamigae-compile compile-vamos.sh "$src" "$out"
    ;;
  run)
    program=${1:?usage: eduamigae run PROGRAM [PROFILE]}
    profile=${2:-amiga-ocs-68000-1m}
    command -v amiga-runtime >/dev/null 2>&1 || {
      echo "amiga-runtime not found; run requires the runtime environment" >&2
      exit 69
    }
    exec amiga-runtime test-hunk "$program" --profile "$profile"
    ;;
  qualify-all)
    cases_dir=${1:-qualification/cases}
    report=${2:-build/qualification/report.json}
    test -d "$cases_dir" || { echo "cases directory not found: $cases_dir" >&2; exit 66; }
    mkdir -p "$(dirname "$report")"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT HUP INT TERM
    total=0; pass=0; fail=0; skip=0
    : >"$tmp/results"
    for casefile in "$cases_dir"/*.json; do
      [ -f "$casefile" ] || continue
      total=$((total + 1))
      id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$casefile")
      if [ ! -d "${EVO_HOME:-}" ] || [ ! -f "${EVO_HOME:-}/E-VO.guide" ]; then
        echo "SKIP $id: E-VO 3.9.4 not provisioned"
        skip=$((skip + 1))
        printf '%s\tSKIP\t%s\n' "$id" "E-VO 3.9.4 not provisioned" >>"$tmp/results"
        continue
      fi
      set +e
      "$0" qualify "$casefile"
      rc=$?
      set -e
      if [ "$rc" -eq 0 ]; then
        pass=$((pass + 1))
        printf '%s\tPASS\t\n' "$id" >>"$tmp/results"
      else
        fail=$((fail + 1))
        printf '%s\tFAIL\texit %s\n' "$id" "$rc" >>"$tmp/results"
      fi
    done
    python3 - "$tmp/results" "$report" "$total" "$pass" "$fail" "$skip" <<'PY'
import json, pathlib, sys
rows=[]
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    ident,status,reason=line.split("\t",2)
    item={"id":ident,"status":status}
    if reason: item["reason"]=reason
    rows.append(item)
out={"schema":1,"total":int(sys.argv[3]),"pass":int(sys.argv[4]),"fail":int(sys.argv[5]),"skip":int(sys.argv[6]),"results":rows}
pathlib.Path(sys.argv[2]).write_text(json.dumps(out,indent=2)+"\n")
print(json.dumps(out,separators=(",",":")))
PY
    [ "$fail" -eq 0 ] || exit 1
    [ "$skip" -eq 0 ] || exit 2
    ;;
  qualify)
    casefile=${1:?usage: eduamigae qualify CASE}
    test -f "$casefile" || { echo "case not found: $casefile" >&2; exit 66; }
    info=$(python3 "$SCRIPT_DIR/case-info.py" "$casefile")
    eval "$info"
    test -f "$SOURCE" || { echo "case source not found: $SOURCE" >&2; exit 66; }
    mkdir -p build/qualification
    program="build/qualification/$OUTPUT"
    "$0" build "$SOURCE" "$program"
    oldifs=$IFS
    IFS=,
    for profile in $PROFILES; do
      IFS=$oldifs
      echo "==> $ID [$COMPATIBILITY] profile=$profile"
      "$0" test "$program" "$casefile" "$profile"
      IFS=,
    done
    IFS=$oldifs
    echo "PASS $ID"
    ;;
  test)
    program=${1:?usage: eduamigae test PROGRAM [CASE] [PROFILE]}
    casefile=${2:-qualification/cases/hello-e33.json}
    profile=${3:-amiga-ocs-68000-1m}
    command -v amiga-runtime >/dev/null 2>&1 || {
      echo "amiga-runtime not found; test requires the runtime environment" >&2
      exit 69
    }
    test -f "$casefile" || { echo "case not found: $casefile" >&2; exit 66; }
    evidence=$(mktemp -d)
    trap 'rm -rf "$evidence"' EXIT HUP INT TERM
    AMIGA_RUNTIME_EVIDENCE="$evidence" amiga-runtime test-hunk "$program" --profile "$profile"
    result="$evidence/result.json"
    test -f "$result" || { echo "runtime produced no result.json" >&2; exit 1; }
    python3 - "$result" <<'PY'
import json, sys
d=json.load(open(sys.argv[1], encoding="utf-8"))
if d.get("status") != "PASS":
    raise SystemExit("runtime qualification did not PASS")
p=d.get("guest_output",{}).get("stdout")
if not p:
    raise SystemExit("runtime result has no guest stdout evidence")
print(p)
PY
    stdout_rel=$(python3 - "$result" <<'PY'
import json, sys
d=json.load(open(sys.argv[1], encoding="utf-8"))
print(d["guest_output"]["stdout"])
PY
)
    stdout="$evidence/$stdout_rel"
    python3 "$SCRIPT_DIR/verify-case.py" "$casefile" "$stdout"
    ;;
  help|-h|--help)
    cat <<'EOF'
EduAmigaE student CLI

  eduamigae doctor
      Verify the open student environment and report E-VO provisioning.

  eduamigae import-evo evo394.lha [DEST]
      Verify the official E-VO 3.9.4 archive and import it.

  eduamigae build SOURCE [OUTPUT]
      Compile an Amiga E source file through E-VO 3.9.4 + vamos.

  eduamigae run PROGRAM [PROFILE]
      Run a generated Amiga Hunk through amiga-runtime.

  eduamigae test PROGRAM [CASE] [PROFILE]
      Require runtime PASS evidence and verify guest stdout against a case.

  eduamigae qualify CASE
      Build and test a qualification case on every profile declared by it.

  eduamigae qualify-all [CASES_DIR] [REPORT]
      Run all cases and write a JSON summary. Exit 1 on FAIL, 2 on SKIP.

E-VO, Kickstart and AmigaOS are not bundled.
EOF
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exit 64
    ;;
esac
